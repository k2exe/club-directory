# Copy to .env and fill in. `docker compose` reads .env automatically.

# --- Hostname -------------------------------------------------------------
# Used by nginx's server_name and as the app's own -base-url (so emailed
# sign-in links point somewhere reachable). Works either way:
#   - a .local.mesh name with no cert available:  http://clubdir.local.mesh
#   - a real domain with a cert you provision:     https://clubdir.example.com
# Scheme here is independent of whether nginx/certs has a cert dropped in —
# nginx never redirects between :80 and :443, so pick whichever matches how
# members will actually reach this server.
SERVER_NAME=clubdir.local.mesh
BASE_URL=http://clubdir.local.mesh

# Only turn this on if BASE_URL is https:// AND nginx/certs has a valid
# cert+key in place (see nginx/certs/README). Off is correct for a bare
# .local.mesh pass-through deployment.
SECURE_COOKIES=

# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Defaults to the
# nginx container's fixed address on the compose network (172.28.1.20) —
# only change this if you edit the `internal` network's subnet in
# docker-compose.yml too.
TRUSTED_PROXIES=172.28.1.20/32

# Creates this address as an admin on first boot, if the roster is empty.
BOOTSTRAP_ADMIN=you@example.com

# Also print outgoing mail to `docker compose logs app` in addition to
# actually sending it. Handy while testing SMTP creds; set to empty in
# steady-state production if you'd rather not have mail bodies in logs.
ECHO_MAIL=

# --- SMTP -------------------------------------------------------------
# Leave SMTP_HOST empty to spool mail to the `outbox` volume instead of
# sending it (useful for a first boot before SMTP creds are ready).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=club-directory@example.com
SMTP_STARTTLS=true
SMTP_INSECURE=

# --- NetRemind scheduler -------------------------------------------------
# The `netremind` compose service sends club net reminder emails once a day
# (same binary, one-shot mode, sharing the app's database volume).
# Time of day the reminders go out, 24h HH:MM, in the container's TZ.
# Set TZ below to your club's time zone so "07:00" means your morning.
CRON_REMIND_TIME=07:00
TZ=America/New_York
