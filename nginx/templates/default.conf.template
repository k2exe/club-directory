server {
	listen 80;
	server_name ${SERVER_NAME};

	# Matches the app's own 8 MB request cap (photo.go), with headroom for
	# multipart overhead, so nginx never rejects an upload the app would accept.
	client_max_body_size 10m;

	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_redirect off;

	# Sign-in links are single-use, 15-minute credentials — keep them out of
	# the access log, same as the README recommends for a bare reverse proxy.
	location /auth/ {
		access_log off;
		proxy_pass http://app:8080;
	}

	location / {
		proxy_pass http://app:8080;
	}
}
